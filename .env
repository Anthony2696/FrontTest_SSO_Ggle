# ============================================================
# SICA 2.0 - Simulador local del login SSO con AWS Lambda
# ============================================================

# --- Web service Lambda ---
# Vacío = usa el mock local http://localhost:4000/dev en desarrollo.
VITE_LAMBDA_URL=https://2tax7xhy4k.execute-api.us-east-1.amazonaws.com/dev/sesion/ggle
VITE_LAMBDA_METHOD=GET
VITE_LAMBDA_BODY_FORMAT=json
VITE_LAMBDA_CODE_FIELD=code
VITE_LAMBDA_EXTRA_PARAMS={"plt":"local","rol":"Administrador","mode":"dev","mail":"","c":""}
# Cabeceras extra en JSON, por ejemplo {"x-api-key":"..."}
VITE_LAMBDA_HEADERS={}
VITE_LAMBDA_TIMEOUT_MS=20000

# --- Redirect URI local ---
VITE_LOCAL_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_SEND_REDIRECT_URI=False
VITE_SEND_CAMPUS=false
VITE_SHOW_DEBUG=true
