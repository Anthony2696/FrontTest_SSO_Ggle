# ============================================================
# SICA 2.0 - Simulador local del login SSO con AWS Lambda
# ============================================================
# Copia este archivo como .env y ajusta los valores.
# Vite solo expone variables que empiezan con VITE_.
# Reinicia `npm run dev` después de cualquier cambio.

# --- Web service Lambda ---
# URL completa del endpoint (API Gateway / Function URL / ruta del recurso).
# Si se deja vacío en desarrollo, se usa el mock local http://localhost:4000/dev
VITE_LAMBDA_URL=

# Método HTTP que espera el Lambda: POST (default) o GET.
VITE_LAMBDA_METHOD=POST

# Formato del cuerpo cuando el método es POST: json (default) o form.
VITE_LAMBDA_BODY_FORMAT=json

# Nombre del parámetro que recibe el código de Google.
VITE_LAMBDA_CODE_FIELD=code

# Parámetros adicionales que se envían siempre, en formato JSON.
# Ejemplo: {"api_key":"123","canal":"web"}
VITE_LAMBDA_EXTRA_PARAMS={}

# Cabeceras HTTP adicionales, en formato JSON.
# Útil si API Gateway exige x-api-key u otro header.
VITE_LAMBDA_HEADERS={}

# Tiempo máximo de espera para cada petición (ms).
VITE_LAMBDA_TIMEOUT_MS=20000

# --- Redirect URI local ---
# Debe coincidir EXACTAMENTE con la URI autorizada en Google Cloud Console
# y con la redirect_uri que el Lambda pone en la url_login.
VITE_LOCAL_REDIRECT_URI=http://localhost:5173/auth/callback

# Enviar redirect_uri como parámetro al Lambda para que genere la url_login
# apuntando al frontend local. Ponlo en false si tu Lambda no acepta ese campo
# y ya lo tiene configurado internamente.
VITE_SEND_REDIRECT_URI=true

# Enviar también el campus seleccionado (parámetro "campus").
VITE_SEND_CAMPUS=false

# Mostrar la consola flotante de depuración (solo en modo desarrollo).
VITE_SHOW_DEBUG=true
